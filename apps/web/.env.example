# ============================================
# Database (docker-compose: port 5433)
# ============================================
DATABASE_URL=postgresql://english_user:english_pass@localhost:5433/english_db
DIRECT_URL=postgresql://english_user:english_pass@localhost:5433/english_db

# ============================================
# NextAuth / Auth.js v5
# Generate: openssl rand -base64 32
# ============================================
AUTH_SECRET=
NEXTAUTH_SECRET=

# ============================================
# Google OAuth (opsional)
# Redirect URI: http://localhost:3000/api/auth/callback/google
# ============================================
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
