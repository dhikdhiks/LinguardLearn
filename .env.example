# ============================================
# Supabase
# NEXT_PUBLIC_* dipakai client-side (browser), DATABASE_URL server-side.
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# Database (Supabase Pooler — Transaction Pooler port 6543 untuk runtime,
# Direct port 5432 untuk migrate). JANGAN pakai localhost di Vercel.
# Local dev alternatif: docker-compose (port 5433).
# ============================================
DATABASE_URL=
DIRECT_URL=

# ============================================
# NextAuth / Auth.js v5
# Generate: openssl rand -base64 32
# WAJIB diset juga di Vercel → Project Settings → Environment Variables.
# ============================================
AUTH_SECRET=
NEXTAUTH_SECRET=

# ============================================
# Google OAuth (WAJIB diisi agar tombol "Login dengan Google" muncul)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client:
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   (production: https://<domain>/api/auth/callback/google)
# Jika dikosongkan, tombol Google disembunyikan otomatis.
# ============================================
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Percaya host dari proxy/reverse-proxy (Vercel) — sudah juga default di code.
AUTH_TRUST_HOST=true
