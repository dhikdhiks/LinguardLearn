# ============================================
# Database (docker-compose: port 5433)
# UNTUK VERCEL: ganti dengan Postgres yang bisa diakses dari internet
# (Neon / Supabase / Vercel Postgres / Railway). JANGAN pakai localhost
# karena server Vercel tidak bisa menjangkau Postgres di laptop kamu.
# ============================================
# SUPABASE: pakai Transaction Pooler (port 6543) untuk serverless (Vercel)
# Contoh: postgresql://postgres.your-ref:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Opsional untuk migrate (bisa pakai Session Pooler/Direct 5432) — lebih stabil
DIRECT_URL=

# ============================================
# NextAuth / Auth.js v5
# Generate: openssl rand -base64 32
# WAJIB diset juga di Vercel → Project Settings → Environment Variables.
# ============================================
AUTH_SECRET=

# ============================================
# Google OAuth (opsional — bisa dikosongkan jika hanya login email/password)
# Di Vercel daftarkan redirect URI:
#   https://<domain-mu>/api/auth/callback/google
# di Google Cloud Console (APIs & Services → Credentials → OAuth 2.0 Client).
# ============================================
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ============================================
# Opsional: percaya host dari proxy/reverse-proxy (Vercel, dll).
# Sudah otomatis aktif via `trustHost: true` di lib/auth.config.ts.
# ============================================
AUTH_TRUST_HOST=true